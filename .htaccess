<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Lindungi file sensitif dari akses publik langsung (403 Forbidden)
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml) - [F,L,NC]

    # 2. Blokir akses langsung ke direktori internal Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/(framework|logs)|tests)/ - [F,L,NC]

    # 3. Jika request sudah mengarah ke /public, biarkan lewat
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # 4. Arahkan semua request domain root langsung ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Matikan directory browsing untuk keamanan
Options -Indexes
